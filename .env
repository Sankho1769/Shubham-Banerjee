APP_NAME=BOARDING
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/boarding/public
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=boarding
DB_USER=boarding_app
DB_PASSWORD=Shubham56ty2

# Set true only once the app is served over HTTPS.
SESSION_SECURE=false

# 'log' writes emails to storage/logs/mail.log instead of sending — safe default for local dev.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@boarding.app
MAIL_FROM_NAME=BOARDING
